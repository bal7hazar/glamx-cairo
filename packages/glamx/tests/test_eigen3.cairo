#[test]
fn test_mirror_vectors() {
    for case in MIRROR.span() {
        let [
            a11,
            a12,
            a13,
            a22,
            a23,
            a33,
            l0,
            l1,
            l2,
            x0,
            x1,
            x2,
            y0,
            y1,
            y2,
            z0,
            z1,
            z2,
            e0,
            e1,
            e2,
        ] =
            *case;
        let a = [a11, a12, a13, a22, a23, a33];
        let expected = SymmetricEigen3 {
            eigenvalues: v3(l0, l1, l2),
            eigenvectors: Mat3 {
                x_axis: v3(x0, x1, x2), y_axis: v3(y0, y1, y2), z_axis: v3(z0, z1, z2),
            },
        };
        let e = SymmetricEigen3Trait::new(sym(a));
        assert_eq!(e, expected);
        assert_eq!(SymmetricEigen3Trait::from_sdp(sdp(a)), expected);
        assert_eq!(sym(a).symmetric_eigen(), expected);
        assert_eq!(SymmetricEigen3Trait::eigenvalues(sym(a)), v3(e0, e1, e2));
        assert_eq!(sym(a).symmetric_eigenvalues(), v3(e0, e1, e2));
        check(sym(a), e);
    }
}

#[test]
fn test_upstream_unit_test() {
    // glamx `eigen_3x3`: eigenvalues -7.6051016780, 0.5774961930, 15.0276054850 (10 decimals,
    // 0.22 ULP), quantized. Documented bound: 0.79 ULP * |A| = 7 ULP for |A| = 8.
    let a = sym([2 * ONE, 7 * ONE, 8 * ONE, 6 * ONE, 3 * ONE, 0]);
    let l = a.symmetric_eigenvalues();
    assert!(l.abs_diff_eq(v3(-32663662990, 2480327262, 64543074095), f(7)));
    assert!(SymmetricEigen3Trait::new(a).eigenvalues.abs_diff_eq(l, f(1)));
}

#[test]
fn test_degenerate_cases() {
    // zero matrix and `Default`
    let zero = SymmetricEigen3Trait::new(sym([0, 0, 0, 0, 0, 0]));
    assert_eq!(zero.eigenvalues, Vec3Trait::ZERO);
    assert_eq!(zero.eigenvectors, Mat3Trait::IDENTITY);
    assert_eq!(zero, Default::default());
    // multiplicity 3 (glamx `eigen_3x3_identity`, `eigen_3x3_uniform_scaling`): exact eigenvalues
    // and the identity basis, from 1 ULP to the largest scaled-up magnitude
    for r in [1, -1, ONE, 5 * ONE, -7 * ONE, 0x3ffffffffffffff].span() {
        let e = SymmetricEigen3Trait::new(sym([*r, 0, 0, *r, 0, *r]));
        assert_eq!(e.eigenvalues, v3(*r, *r, *r));
        assert_eq!(e.eigenvectors, Mat3Trait::IDENTITY);
    }
    // diagonal (glamx `eigen_3x3_diagonal`): exact eigenvalues, the eigenvectors are the axes
    let e = SymmetricEigen3Trait::new(sym([2 * ONE, 0, 0, 5 * ONE, 0, 3 * ONE]));
    assert_eq!(e.eigenvalues, v3(2 * ONE, 3 * ONE, 5 * ONE));
    assert_eq!(e.eigenvectors.x_axis, Vec3Trait::X);
    assert_eq!(e.eigenvectors.y_axis, Vec3Trait::Z);
    assert_eq!(e.eigenvectors.z_axis, -Vec3Trait::Y);
    // multiplicity 2 off the axes: [[2, 1, 1], [1, 2, 1], [1, 1, 2]] has eigenvalues (1, 1, 4)
    let e = SymmetricEigen3Trait::new(sym([2 * ONE, ONE, ONE, 2 * ONE, ONE, 2 * ONE]));
    assert_eq!(e.eigenvalues, v3(ONE, ONE, 4 * ONE));
    // rank one: u u^T with u = (1, 2, 3) has eigenvalues (0, 0, 14)
    let e = SymmetricEigen3Trait::new(sym([ONE, 2 * ONE, 3 * ONE, 4 * ONE, 6 * ONE, 9 * ONE]));
    assert_eq!(e.eigenvalues, v3(0, 0, 14 * ONE));
    // a single off-diagonal ULP: eigenvalues (-1, 0, 1) ULP
    let e = SymmetricEigen3Trait::new(sym([0, 1, 0, 0, 0, 0]));
    assert_eq!(e.eigenvalues, v3(-1, 0, 1));
}

#[test]
fn test_extreme_magnitudes() {
    // 2^26 and above: scaled down by 2^6, eigenvalues are multiples of 64 ULP
    let top = 0x7fffffffffffffff;
    let e = SymmetricEigen3Trait::new(sym([top, 0, 0, top, 0, top]));
    assert_eq!(e.eigenvalues, v3(top - 63, top - 63, top - 63));
    let e = SymmetricEigen3Trait::new(sym([-top, 0, 0, 5, 0, 7]));
    assert_eq!(e.eigenvalues, v3(-top - 1, 0, 0));
    // all entries 2^29: eigenvalues (0, 0, 3 * 2^29), the largest that never overflows
    let r = 0x2000000000000000;
    let e = SymmetricEigen3Trait::new(sym([r, r, r, r, r, r]));
    assert_eq!(e.eigenvalues, v3(0, 0, 3 * r));
    check(sym([r, r, r, r, r, r]), e);
}

#[test]
fn test_reads_the_upper_triangle() {
    let a = sym([2 * ONE, 7 * ONE, 8 * ONE, 6 * ONE, 3 * ONE, 0]);
    let mut lower = a;
    lower.x_axis.y = f(123);
    lower.x_axis.z = f(-456);
    lower.y_axis.z = f(789);
    assert_eq!(SymmetricEigen3Trait::new(lower), SymmetricEigen3Trait::new(a));
    assert_eq!(lower.symmetric_eigenvalues(), a.symmetric_eigenvalues());
}

#[test]
fn test_reverse() {
    let e = SymmetricEigen3Trait::new(sym([2 * ONE, 7 * ONE, 8 * ONE, 6 * ONE, 3 * ONE, 0]));
    let r = e.reverse();
    assert_eq!(r.eigenvalues, v3(e.eigenvalues.z.raw, e.eigenvalues.y.raw, e.eigenvalues.x.raw));
    assert_eq!(r.eigenvectors.x_axis, e.eigenvectors.z_axis);
    assert_eq!(r.eigenvectors.y_axis, e.eigenvectors.y_axis);
    assert_eq!(r.eigenvectors.z_axis, e.eigenvectors.x_axis);
    assert_eq!(r.reverse(), e);
}

#[test]
fn test_swap_cols() {
    // glamx `test_mat3_swap_cols`
    let (c0, c1, c2) = (v3(1, 2, 3), v3(4, 5, 6), v3(7, 8, 9));
    let mut m = Mat3 { x_axis: c0, y_axis: c1, z_axis: c2 };
    m.swap_cols(0, 2);
    assert_eq!(m, Mat3 { x_axis: c2, y_axis: c1, z_axis: c0 });
    m.swap_cols(1, 0);
    assert_eq!(m, Mat3 { x_axis: c1, y_axis: c2, z_axis: c0 });
    m.swap_cols(2, 2);
    assert_eq!(m, Mat3 { x_axis: c1, y_axis: c2, z_axis: c0 });
    // parry `with_inertia_matrix`: swapping two columns flips the handedness
    let mut v = SymmetricEigen3Trait::new(sym([2 * ONE, ONE, 0, 3 * ONE, ONE, 4 * ONE]))
        .eigenvectors;
    v.swap_cols(1, 2);
    assert!(v.determinant().raw < -ONE / 2);
}

