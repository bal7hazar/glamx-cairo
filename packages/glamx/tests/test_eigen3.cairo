// Fuzz properties.

/// The `k`-th fuzzed raw entry, |value| <= 8.
fn cell(v: i64, k: i64) -> i64 {
    (v / (k + 1) + k * 2654435761) % 0x800000000
}

fn fuzz_sym(a: i64, b: i64, c: i64) -> [i64; 6] {
    [cell(a, 0), cell(b, 1), cell(c, 2), cell(b, 3), cell(a, 4), cell(c, 5)]
}

#[test]
#[fuzzer(runs: 128, seed: 801)]
fn fuzz_decomposition(a: i64, b: i64, c: i64) {
    let s = fuzz_sym(a, b, c);
    let e = SymmetricEigen3Trait::new(sym(s));
    check(sym(s), e);
    assert_eq!(SymmetricEigen3Trait::from_sdp(sdp(s)), e);
    // the trace is the sum of the eigenvalues: 3 * 0.79 ULP * |A| with |A| <= 8
    let l = e.eigenvalues;
    let [a11, _, _, a22, _, a33] = s;
    assert!(abs(l.x.raw + l.y.raw + l.z.raw - a11 - a22 - a33) <= 19);
    // `eigenvalues` skips the polish of the eigenvectors: 1 ULP from `new` at most (measured)
    assert!(SymmetricEigen3Trait::eigenvalues(sym(s)).abs_diff_eq(l, f(1)));
}

/// `16^k` for `k` in `0..12`.
const POW16: [i64; 12] = [
    0x1, 0x10, 0x100, 0x1000, 0x10000, 0x100000, 0x1000000, 0x10000000, 0x100000000, 0x1000000000,
    0x10000000000, 0x100000000000,
];

#[test]
#[fuzzer(runs: 128, seed: 802)]
fn fuzz_magnitudes(a: i64, b: i64, c: i64, k: u8) {
    // entries below 2^(4 + 4 k) raw: from a few ULPs to 2^16
    let p = *POW16.span()[(k % 12).into()];
    let [a11, a12, a13, a22, a23, a33] = fuzz_sym(a, b, c);
    let q = 0x80000000;
    let s = [a11 / q * p, a12 / q * p, a13 / q * p, a22 / q * p, a23 / q * p, a33 / q * p];
    check(sym(s), SymmetricEigen3Trait::new(sym(s)));
}

#[test]
#[fuzzer(runs: 128, seed: 803)]
fn fuzz_scale_covariance(a: i64, b: i64, c: i64) {
    // 16 A falls in the next scale bucket: the scaled matrix, hence the rotations and the
    // eigenvectors, are identical bit for bit; each eigenvalue is rounded from the same scaled
    // value at two resolutions, 16 * 1/2 ULP apart at most.
    let [a11, a12, a13, a22, a23, a33] = fuzz_sym(a, b, c);
    let e = SymmetricEigen3Trait::new(sym([a11, a12, a13, a22, a23, a33]));
    let big = [16 * a11, 16 * a12, 16 * a13, 16 * a22, 16 * a23, 16 * a33];
    let e16 = SymmetricEigen3Trait::new(sym(big));
    assert_eq!(e16.eigenvectors, e.eigenvectors);
    assert!(e16.eigenvalues.abs_diff_eq(e.eigenvalues.mul_scalar(f(16 * ONE)), f(8)));
}

#[test]
#[fuzzer(runs: 128, seed: 804)]
fn fuzz_diagonal_is_exact(a: i64, b: i64, c: i64) {
    // below 2^26 a diagonal matrix is never rotated: sorted entries, signed axes
    let (x, y, z) = (a % 0x400000000000000, b % 0x400000000000000, c % 0x400000000000000);
    let e = SymmetricEigen3Trait::new(sym([x, 0, 0, y, 0, z]));
    let l = e.eigenvalues;
    assert!(l.x <= l.y && l.y <= l.z);
    assert_eq!(l.x.raw + l.y.raw + l.z.raw, x + y + z);
    assert!(l.x.raw == x || l.x.raw == y || l.x.raw == z);
    assert!(l.z.raw == x || l.z.raw == y || l.z.raw == z);
    let v = e.eigenvectors;
    assert_eq!(v.transpose() * v, Mat3Trait::IDENTITY);
    assert_eq!(v.determinant().raw, ONE);
    // no rotation: `eigenvalues` returns the same sorted diagonal
    assert_eq!(SymmetricEigen3Trait::eigenvalues(sym([x, 0, 0, y, 0, z])), l);
}

#[test]
#[fuzzer(runs: 128, seed: 805)]
fn fuzz_two_equal_eigenvalues(a: i64, b: i64, c: i64) {
    // A = l1 I + (l2 - l1) n n^T: eigenvalues (l1, l1, l2) up to the quantization of A. Each
    // entry is off by 1 ULP (floor) + 2 * 1 ULP * |l2 - l1| (the rounding of `n`, |n_i| <= 1,
    // |l2 - l1| <= 16), i.e. 33 ULP; Weyl: eigenvalues move by at most 3 * 33 ULP, + 13 ULP for
    // the documented 0.79 ULP * |A| (|A| <= 16).
    let n = Vec3 { x: f(cell(a, 0) + 1), y: f(cell(b, 1)), z: f(cell(c, 2)) }.normalize();
    let (l1, l2) = (f(cell(c, 3)), f(cell(a, 4)));
    let d = l2 - l1;
    let s = SdpMatrix3Trait::new(
        l1 + d * n.x * n.x,
        d * n.x * n.y,
        d * n.x * n.z,
        l1 + d * n.y * n.y,
        d * n.y * n.z,
        l1 + d * n.z * n.z,
    );
    let e = SymmetricEigen3Trait::from_sdp(s);
    check(s.into_matrix(), e);
    let expected = if l1 <= l2 {
        Vec3 { x: l1, y: l1, z: l2 }
    } else {
        Vec3 { x: l2, y: l1, z: l1 }
    };
    assert!(e.eigenvalues.abs_diff_eq(expected, f(112)));
}

