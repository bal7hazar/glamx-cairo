//! Tests of `glamx::eigen3`.
//!
//! * `MIRROR`: inputs and bit-exact outputs of the Python mirror (`scripts/gen_eigen3.py
//!   vectors`): the Cairo module and the script that measured its accuracy are the same function.
//! * Eigenvectors are never compared component-wise (their sign and the basis of a repeated
//!   eigenspace are arbitrary): `check` verifies the ascending order, `A v = lambda v`, the
//!   orthonormality, the handedness and the reconstruction `V diag(lambda) V^T = A`.
//! * Tolerances, in raw ULPs, are the documented worst cases of the module (measured by
//!   `scripts/gen_eigen3.py study` over 45 026 matrices, per unit of `|A| = max(1, max |a_ij|)`:
//!   residual 9.6, reconstruction 9.4, orthonormality 3.5 absolute) rounded up to 16 / 16 / 4,
//!   plus the rounding of the test's own arithmetic (stated at each assertion).
//!
//! The eigenvalues are also compared with glamx's f64 `DSymmetricEigen3` and with an f64 Jacobi
//! iteration in `golden_eigen3.cairo` (generated by `tools/refgen`).

use fixed::fixed::{Fixed, FixedTrait};
use glam_core::mat3::{Mat3, Mat3Trait};
use glam_core::vec3::{Vec3, Vec3Trait};
use glamx::eigen3::{Mat3ExtTrait, SymmetricEigen3, SymmetricEigen3Trait};
use glamx::sdp::{SdpMatrix3, SdpMatrix3Trait};

const ONE: i64 = 0x100000000;

/// A `Fixed` from its raw Q32.32 value.
fn f(raw: i64) -> Fixed {
    FixedTrait::from_raw(raw)
}

fn v3(x: i64, y: i64, z: i64) -> Vec3 {
    Vec3 { x: f(x), y: f(y), z: f(z) }
}

/// The symmetric matrix of the 6 raw entries `(a11, a12, a13, a22, a23, a33)`.
fn sdp(a: [i64; 6]) -> SdpMatrix3 {
    let [a11, a12, a13, a22, a23, a33] = a;
    SdpMatrix3Trait::new(f(a11), f(a12), f(a13), f(a22), f(a23), f(a33))
}

fn sym(a: [i64; 6]) -> Mat3 {
    sdp(a).into_matrix()
}

fn abs(x: i64) -> i64 {
    if x < 0 {
        -x
    } else {
        x
    }
}

/// `max(1, ceil(max |a_ij|))`: the unit of the documented error bounds.
fn magnitude(a: Mat3) -> i64 {
    let m = a.abs();
    let top = m.x_axis.max(m.y_axis).max(m.z_axis).max_element().raw;
    top / ONE + 1
}

/// Every invariant of a decomposition `e` of the symmetric matrix `a`.
fn check(a: Mat3, e: SymmetricEigen3) {
    let scale = magnitude(a);
    let l = e.eigenvalues;
    let v = e.eigenvectors;
    assert!(l.x <= l.y && l.y <= l.z, "ascending order");
    // A v = lambda v: documented 16 ULP * |A|, + 1 ULP for the floor of `A v` and 1 for the
    // floor of `lambda v`.
    let tol = f(16 * scale + 2);
    assert!(a.mul_vec3(v.x_axis).abs_diff_eq(v.x_axis.mul_scalar(l.x), tol), "residual 1");
    assert!(a.mul_vec3(v.y_axis).abs_diff_eq(v.y_axis.mul_scalar(l.y), tol), "residual 2");
    assert!(a.mul_vec3(v.z_axis).abs_diff_eq(v.z_axis.mul_scalar(l.z), tol), "residual 3");
    // V^T V = I: documented 4 ULP, + 1 ULP for the floor of each dot product.
    assert!((v.transpose() * v).abs_diff_eq(Mat3Trait::IDENTITY, f(5)), "orthonormality");
    // right-handed: with orthonormal columns the determinant is +1 or -1
    assert!(v.determinant().raw > ONE / 2, "handedness");
    // V diag(lambda) V^T = A: documented 16 ULP * |A|, + 1 ULP for the floor of the exact
    // triple-product sums of `from_rotated_diagonal_mat3`.
    let back = SdpMatrix3Trait::from_rotated_diagonal_mat3(v, l).into_matrix();
    assert!(back.abs_diff_eq(a, f(16 * scale + 1)), "reconstruction");
}
